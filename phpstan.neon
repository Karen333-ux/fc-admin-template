includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6

    # كاش داخل المشروع بدل %tmp% المشترك — الكاش المشترك كان بيدّي
    # "Undefined constant LARAVEL_VERSION" في تشغيلات متبادلة.
    tmpDir: .phpstan.cache

    parallel:
        maximumNumberOfProcesses: 1

    paths:
        - app
        - src
        - config
        - database

    excludePaths:
        - src/Support/Infrastructure/Authorization/helpers.php

    # مفيش ignoreErrors. استثناء trait.unused لـ BelongsToTenant اتشال:
    # `TenantSetting` بقى أول موديل إنتاجي بيستخدمه (شريحة ٢).
