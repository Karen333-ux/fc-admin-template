includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6

    # كاش داخل المشروع بدل %tmp% المشترك — الكاش المشترك كان بيدّي
    # "Undefined constant LARAVEL_VERSION" في تشغيلات متبادلة.
    tmpDir: .phpstan.cache

    parallel:
        maximumNumberOfProcesses: 1

    paths:
        - app
        - src
        - config
        - database

    excludePaths:
        - src/Support/Infrastructure/Authorization/helpers.php

    ignoreErrors:
        # الـ trait مستخدم من فيكستشر الاختبارات بس. ربط الوسائط بموديل إنتاجي
        # (`User` — docs/04 بند ٥) بيلمس سياق Identity وبره نطاق شريحة التخزين،
        # فلسه مفيش صاحب وسائط إنتاجي. (ADR-022)
        # يتشال أول ما يتعمل أول موديل بيستخدمه.
        -
            identifier: trait.unused
            path: src/Support/Infrastructure/Persistence/Concerns/InteractsWithResolvedMedia.php
