# اسم مشروع Compose — بيحدّد أسماء الـ volumes، فبيعزل قاعدة البيانات
# عن أي ستاك تاني على نفس الجهاز. (docs/00 بند ١)
COMPOSE_PROJECT_NAME=fc-admin-template

APP_NAME="FC Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

# بروكسيات موثوقة خلف اللوحة (load balancer/reverse proxy). `*` تعني
# الثقة بأي بروكسي مباشر — مقبول محلياً، حط CIDR صريح في الإنتاج.
# (docs/14 بند ١)
TRUSTED_PROXIES=*

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── مراقبة الأخطاء (Sentry) — فاضية محلياً، الـ SDK بيتجاهل نفسه من
# غير DSN. (docs/14 بند ٢ · docs/11 بند ٦) ──
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

# ── قاعدة البيانات — PostgreSQL 18. مفيش SQLite. (docs/23 بند ٧) ──
# القيم دي للاتصال **من المضيف**. جوّه Docker الـ compose بيغيّرها
# لـ postgres:5432 عبر environment. (docs/00 بند ١)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5434
DB_DATABASE=fc_admin
DB_USERNAME=fc
DB_PASSWORD=secret

# ── الجلسات على قاعدة البيانات في كل البيئات (ADR-004) ──
# «إدارة الأجهزة» و«إنهاء كل الجلسات» محتاجين استعلام على الجلسات،
# وده تافه على SQL ومؤلم على Redis.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# null محلياً (مسار HTTP على منفذ ٨٠٨١) — true إلزامي في الإنتاج
# فوق HTTPS، وإلا الكوكي بيتبعت على قناة غير مشفّرة. (docs/14 بند ٢)
SESSION_SECURE_COOKIE=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ── S3 (ديسكات s3 وs3-private، config/filesystems.php) — فاضية محلياً،
# التخزين على local بدلها. لازم قيمة حقيقية قبل أي استخدام فعلي لـ S3
# في الإنتاج. (docs/04 بند ٢ · docs/14 بند ٢) ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_PRIVATE_BUCKET=
AWS_URL=

# ── Redis 8 — كاش وطوابير ──
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6381

# سقوف عمال Horizon وقت الضغط — config/horizon.php.
# القيم دي هي الافتراضية في الكونفج نفسه، متكتوبة هنا عشان تبان.
# صغّريها على سيرفر مشترك: مجموعهم × ~150 ميجا لازم يقعد في الذاكرة المتاحة.
HORIZON_CRITICAL_MAX=10
HORIZON_NOTIFICATIONS_MAX=8
HORIZON_MEDIA_MAX=6
HORIZON_DEFAULT_MAX=6

# مدة كاش الصلاحيات — config/permission.php. القيمة نفسها الافتراضية
# اللي الباكدج بيستخدمها لو مفيش قيمة. (docs/14 بند ٢)
PERMISSION_CACHE_TTL="24 hours"

MAIL_MAILER=log

# إيميل تنبيهات النسخ الاحتياطي (فشل/نجاح/تراكم). فاضي محلياً — إشعارات
# البريد بتتبعت بس لو فيه قيمة. (docs/11 بند ٩)
BACKUP_ALERT_EMAIL=

VITE_APP_NAME="${APP_NAME}"
