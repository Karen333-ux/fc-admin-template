# اسم مشروع Compose — بيحدّد أسماء الـ volumes، فبيعزل قاعدة البيانات
# عن أي ستاك تاني على نفس الجهاز. (docs/00 بند ١)
COMPOSE_PROJECT_NAME=fc-admin-template

APP_NAME="FC Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── قاعدة البيانات — PostgreSQL 18. مفيش SQLite. (docs/23 بند ٧) ──
# القيم دي للاتصال **من المضيف**. جوّه Docker الـ compose بيغيّرها
# لـ postgres:5432 عبر environment. (docs/00 بند ١)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5434
DB_DATABASE=fc_admin
DB_USERNAME=fc
DB_PASSWORD=secret

# ── الجلسات على قاعدة البيانات في كل البيئات (ADR-004) ──
# «إدارة الأجهزة» و«إنهاء كل الجلسات» محتاجين استعلام على الجلسات،
# وده تافه على SQL ومؤلم على Redis.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ── Redis 8 — كاش وطوابير ──
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6381

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"
